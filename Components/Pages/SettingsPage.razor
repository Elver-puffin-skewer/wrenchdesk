@page "/settings"
@inject SettingsStore Settings
@inject BackupService Backups
@inject Db Database
@inject GoogleAuthService Auth
@inject CalendarSyncService Sync
@inject ScheduleRepo Schedule
@inject NavigationManager Nav

<PageTitle>Settings — WrenchDesk</PageTitle>

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p class="sub">Shop details, default rates, and where your data lives.</p>
    </div>
</div>

@if (_flash is not null)
{
    <div class="alert alert-ok">@_flash</div>
}

<div class="grid cols-2">
    <div class="card">
        <div class="card-head"><h2>Shop details</h2></div>
        <div class="card-body">
            <div class="muted small" style="margin-bottom:.9rem">These appear at the top of printed estimates and invoices.</div>

            <div class="field">
                <label>Shop name</label>
                <input type="text" @bind="_values[SettingsStore.ShopName]" />
            </div>
            <div class="field">
                <label>Address</label>
                <textarea rows="3" @bind="_values[SettingsStore.ShopAddress]"></textarea>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label>Phone</label>
                    <input type="tel" @bind="_values[SettingsStore.ShopPhone]" />
                </div>
                <div class="field">
                    <label>Email</label>
                    <input type="email" @bind="_values[SettingsStore.ShopEmail]" />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h2>Defaults</h2></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="field">
                    <label>Labor rate (per hour)</label>
                    <input type="text" @bind="_laborRate" />
                    <div class="muted small" style="margin-top:.2rem">Prefills every labor line you add.</div>
                </div>
                <div class="field">
                    <label>Sales tax %</label>
                    <input type="text" @bind="_taxRate" />
                    <div class="muted small" style="margin-top:.2rem">Applied to new tickets. Use 0 if you do not charge tax.</div>
                </div>
                <div class="field">
                    <label>Ticket prefix</label>
                    <input type="text" maxlength="6" @bind="_values[SettingsStore.TicketPrefix]" />
                    <div class="muted small" style="margin-top:.2rem">Numbers look like @(_values[SettingsStore.TicketPrefix])-1042.</div>
                </div>
                <div class="field">
                    <label>Week starts on</label>
                    <select @bind="_values[SettingsStore.WeekStartDay]">
                        @foreach (var d in Enum.GetNames<DayOfWeek>())
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                    <div class="muted small" style="margin-top:.2rem">Controls the weekly money totals.</div>
                </div>
            </div>

            <div class="field" style="margin-bottom:0">
                <label>Estimate footer</label>
                <textarea rows="3" @bind="_values[SettingsStore.EstimateFooter]"></textarea>
                <div class="muted small" style="margin-top:.2rem">Printed at the bottom of estimates, above the signature line.</div>
            </div>
        </div>
    </div>
</div>

<div class="btn-row" style="margin-bottom:1.5rem">
    <button class="btn btn-primary btn-lg" @onclick="Save">Save settings</button>
</div>

<div class="card">
    <div class="card-head"><h2>Your data</h2></div>
    <div class="card-body">
        <dl class="kv">
            <dt>Database file</dt>
            <dd class="mono small">@Database.DatabasePath</dd>
            <dt>Size</dt>
            <dd>@FormatSize(_dbSize)</dd>
        </dl>

        <div class="alert alert-info" style="margin-top:1rem;margin-bottom:0">
            Everything lives in that one file. Any backup below is a complete copy — to restore it,
            or to move the shop to a new PC, rename it to <span class="mono">wrenchdesk.db</span> and
            put it where the database file lives. There is nothing else to restore.
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>Back up now</h2>
        <div class="spacer"></div>
        <button class="btn btn-sm" @onclick="RefreshDrives" disabled="@_busy">↻ Rescan drives</button>
    </div>
    <div class="card-body">
        <p class="muted small" style="margin-bottom:1rem">
            Writes a copy straight away — to a USB stick, an external drive, or any folder.
            Drives are the ones plugged into the shop PC, even if you are looking at this on a tablet.
        </p>

        <div class="form-grid">
            <div class="field">
                <label>Drive or folder</label>
                <select value="@_manualRoot" @onchange="OnManualRootChange">
                    @foreach (var d in _drives)
                    {
                        <option value="@d.Root">@d.Display</option>
                    }
                    <option value="@CustomPathOption">Somewhere else (type a path)…</option>
                </select>
            </div>
            <div class="field">
                <label>@(_manualRoot == CustomPathOption ? "Full folder path" : "Folder on that drive")</label>
                <input type="text" @bind="_manualFolder"
                       placeholder="@(_manualRoot == CustomPathOption ? "D:\\ShopBackups" : "WrenchDesk Backups")" />
            </div>
        </div>

        <div class="muted small" style="margin-bottom:1rem">
            Will write to <span class="mono">@ManualDestination()</span>
        </div>

        <div class="btn-row">
            <button class="btn btn-primary" @onclick="BackUpToChosen" disabled="@_busy">
                @(_busy ? "Working…" : "Back up to this drive")
            </button>
            <button class="btn" @onclick="BackUpToDataFolder" disabled="@_busy">Back up to the data folder</button>
        </div>

        @if (_manualResult is not null)
        {
            <div class="alert @(_manualResult.Success ? "alert-ok" : "alert-danger")" style="margin:1rem 0 0">
                @if (_manualResult.Success)
                {
                    <div><strong>Backup saved.</strong> @DriveOption.FormatSize(_manualResult.Bytes)</div>
                    <div class="mono small" style="margin-top:.25rem">@_manualResult.Path</div>
                }
                else
                {
                    <div><strong>Backup failed.</strong> @_manualResult.Error</div>
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>Automatic backups</h2>
        <div class="spacer"></div>
        <span class="badge @(_autoEnabled ? "badge-ready" : "badge-closed")">@(_autoEnabled ? "On" : "Off")</span>
    </div>
    <div class="card-body">
        <label class="check" style="margin-bottom:1rem">
            <input type="checkbox" checked="@_autoEnabled" @onchange="OnAutoToggle" />
            Run backups on a schedule
        </label>

        @if (!_autoEnabled)
        {
            <div class="alert alert-warn" style="margin-bottom:0">
                Automatic backups are off, so nothing is being saved on a schedule. If this PC's drive
                fails, the shop loses everything since the last time someone pressed
                <em>Back up now</em>. Consider turning this on with a USB drive as the destination.
            </div>
        }
        else
        {
            <div class="form-grid">
                <div class="field">
                    <label>How often</label>
                    <select @bind="_frequency" @bind:after="Save">
                        @foreach (var f in BackupFrequency.All)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>At what time</label>
                    <input type="time" @bind="_scheduleTime" @bind:after="Save" />
                    <div class="muted small" style="margin-top:.2rem">
                        Pick a time the PC is normally on — after closing, but before it gets switched off.
                    </div>
                </div>

                @if (_frequency == BackupFrequency.Weekly)
                {
                    <div class="field">
                        <label>Which day</label>
                        <select @bind="_scheduleDay" @bind:after="Save">
                            @foreach (var d in Enum.GetValues<DayOfWeek>())
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                }

                <div class="field">
                    <label>Keep how many</label>
                    <input type="number" min="1" max="500" @bind="_keepCount" @bind:after="Save" />
                    <div class="muted small" style="margin-top:.2rem">
                        Older ones are removed once there are more than this. Only files WrenchDesk
                        wrote are ever touched.
                    </div>
                </div>

                <div class="field span-2">
                    <label>Save them to</label>
                    <select value="@_scheduleRoot" @onchange="OnScheduleRootChange">
                        <option value="">The data folder (same drive as the database)</option>
                        @foreach (var d in _drives)
                        {
                            <option value="@d.Root">@d.Display</option>
                        }
                        <option value="@CustomPathOption">Somewhere else (type a path)…</option>
                    </select>
                </div>

                @if (_scheduleRoot != "")
                {
                    <div class="field span-2">
                        <label>@(_scheduleRoot == CustomPathOption ? "Full folder path" : "Folder on that drive")</label>
                        <input type="text" @bind="_scheduleFolder" @bind:after="Save"
                               placeholder="WrenchDesk Backups" />
                    </div>
                }
            </div>

            @if (_scheduleRoot == "")
            {
                <div class="alert alert-warn">
                    These backups land on the same drive as the live database. That protects you from a
                    mistake — deleting the wrong customer — but not from the drive itself failing.
                    Pick a USB or external drive to be covered for both.
                </div>
            }

            <dl class="kv" style="margin-top:.5rem">
                <dt>Schedule</dt>
                <dd>@BackupSchedule.Describe(_frequency, _scheduleTime, _scheduleDay)</dd>
                <dt>Saving to</dt>
                <dd class="mono small">@ScheduleDestination()</dd>
                <dt>Last run</dt>
                <dd>
                    @if (_lastRun is null)
                    {
                        <span class="muted">Never</span>
                    }
                    else
                    {
                        <span>@_lastRun.Value.ToString("MMM d, yyyy h:mm tt")</span>
                    }
                </dd>
                <dt>Next run</dt>
                <dd>@BackupSchedule.NextOccurrence(DateTime.Now, _frequency, _scheduleTime, _scheduleDay).ToString("dddd MMM d, h:mm tt")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_lastError))
            {
                <div class="alert alert-danger" style="margin:1rem 0 0">
                    <strong>Last scheduled backup failed:</strong> @_lastError
                    <div class="small" style="margin-top:.25rem">
                        It will be retried automatically. If the destination is a USB drive, check it is plugged in.
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>Google Calendar</h2>
        <div class="spacer"></div>
        <span class="badge @(_googleConnected && _syncEnabled ? "badge-ready" : "badge-closed")">
            @(!_googleConnected ? "Not connected" : _syncEnabled ? "Syncing" : "Connected, paused")
        </span>
    </div>
    <div class="card-body">
        @if (_googleFlash is not null)
        {
            <div class="alert @_googleFlashClass">@_googleFlash</div>
        }

        @if (_needsReconnect)
        {
            <div class="alert alert-danger">
                <strong>Google has dropped the connection.</strong> Nothing is syncing until you reconnect below.
                <div class="small" style="margin-top:.25rem">
                    If the OAuth consent screen in Google Cloud is still set to <em>Testing</em>, Google
                    expires the connection every 7 days. Setting it to <em>In production</em> stops that.
                </div>
            </div>
        }

        @if (!_googleConfigured)
        {
            <div class="alert alert-info">
                <strong>One-time setup.</strong> Google requires each shop to use its own credentials —
                they cannot be shipped inside the app. <a href="/help#google">Help</a> explains what this
                does and what to watch for; the step-by-step is in the setup guide. Ten minutes, no cost.
            </div>
        }

        <div class="form-grid">
            <div class="field">
                <label>Client ID</label>
                <input type="text" @bind="_googleClientId" placeholder="…apps.googleusercontent.com" />
            </div>
            <div class="field">
                <label>Client secret</label>
                <input type="password" @bind="_googleClientSecret" placeholder="GOCSPX-…" />
            </div>
            <div class="field span-2">
                <div class="muted small">
                    In Google Cloud, the authorised redirect URI must be exactly:
                    <span class="mono">@_redirectUri</span>
                </div>
            </div>
        </div>

        <div class="btn-row" style="margin-bottom:.5rem">
            <button class="btn" @onclick="SaveGoogleCredentials">Save credentials</button>

            @if (_googleConfigured)
            {
                <a class="btn btn-primary" href="/google/connect">
                    @(_googleConnected ? "Reconnect Google account" : "Connect Google account")
                </a>
            }

            @if (_googleConnected)
            {
                <button class="btn btn-danger" @onclick="() => _confirmDisconnect = true">Disconnect</button>
            }
        </div>

        @if (_googleConnected)
        {
            <hr style="border:0;border-top:1px solid var(--line-2);margin:1.25rem 0" />

            <div class="form-grid">
                <div class="field span-2">
                    <label>Calendar to sync with</label>
                    @if (_calendars.Count == 0)
                    {
                        <div class="btn-row">
                            <button class="btn btn-sm" @onclick="LoadCalendars" disabled="@_googleBusy">
                                @(_googleBusy ? "Loading…" : "Load my calendars")
                            </button>
                        </div>
                    }
                    else
                    {
                        <select value="@_calendarId" @onchange="OnCalendarChange">
                            <option value="">— choose a calendar —</option>
                            @foreach (var c in _calendars.Where(c => c.CanWrite))
                            {
                                <option value="@c.Id">@c.Name @(c.IsPrimary ? "(main calendar)" : "")</option>
                            }
                        </select>
                    }
                    <div class="muted small" style="margin-top:.35rem">
                        Use a calendar kept just for shop work. Everything on it is treated as shop
                        jobs — an event added on a phone becomes an appointment here — so pointing this
                        at a personal calendar would pull in dentist appointments and birthdays.
                    </div>
                </div>

                <div class="field span-2">
                    <div class="btn-row">
                        <button class="btn btn-sm" @onclick="CreateShopCalendar" disabled="@_googleBusy">
                            + Create a new &ldquo;@_shopNameForCalendar&rdquo; calendar
                        </button>
                        @if (_calendars.Count > 0)
                        {
                            <button class="btn btn-sm" @onclick="LoadCalendars" disabled="@_googleBusy">↻ Refresh list</button>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_calendarId))
            {
                <label class="check" style="margin:1rem 0">
                    <input type="checkbox" checked="@_syncEnabled" @onchange="OnSyncToggle" />
                    Keep this calendar and the shop schedule in step, both ways
                </label>

                <div class="form-grid">
                    <div class="field">
                        <label>Check every</label>
                        <select @bind="_syncIntervalMin" @bind:after="SaveGoogleSettings">
                            <option value="1">1 minute</option>
                            <option value="5">5 minutes</option>
                            <option value="15">15 minutes</option>
                            <option value="30">30 minutes</option>
                            <option value="60">1 hour</option>
                        </select>
                        <div class="muted small" style="margin-top:.2rem">
                            Google cannot reach a shop PC directly, so WrenchDesk asks on this interval.
                        </div>
                    </div>
                    <div class="field">
                        <label>&nbsp;</label>
                        <button class="btn btn-primary btn-block" @onclick="SyncNow" disabled="@_googleBusy">
                            @(_googleBusy ? "Syncing…" : "Sync now")
                        </button>
                    </div>
                </div>

                <dl class="kv" style="margin-top:.75rem">
                    <dt>Last sync</dt>
                    <dd>
                        @if (_lastSync is null)
                        {
                            <span class="muted">Never</span>
                        }
                        else
                        {
                            <span>@_lastSync.Value.ToString("MMM d, h:mm tt")</span>
                            @if (!string.IsNullOrWhiteSpace(_lastSyncResult))
                            {
                                <span class="muted"> — @_lastSyncResult</span>
                            }
                        }
                    </dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(_googleLastError))
                {
                    <div class="alert alert-danger" style="margin:.5rem 0 0">
                        <strong>Last sync problem:</strong> @_googleLastError
                    </div>
                }

                <div class="alert alert-info" style="margin:1rem 0 0">
                    <strong>How the two directions behave.</strong> Move or cancel a stop in Google and it
                    changes here. Write one up here and it appears there. If the same stop is edited in
                    both places between syncs, the most recent edit wins. All-day entries on the calendar
                    are left alone — a shop stop has a time.
                </div>
            }
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>Backups on hand</h2>
        <div class="spacer"></div>
        <span class="muted small mono">@_listedFolder</span>
    </div>

    @if (_backups.Count == 0)
    {
        <div class="empty" style="padding:1.75rem 1.5rem">
            <div class="big">💾</div>
            <div>No backups in this folder yet.</div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>File</th><th>Taken</th><th class="num">Size</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in _backups.Take(15))
                    {
                        <tr>
                            <td class="mono small">@b.Name</td>
                            <td class="small">@b.LastWriteTime.ToString("MMM d, yyyy h:mm tt")</td>
                            <td class="num small">@FormatSize(b.Length)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_confirmDisconnect)
{
    <Modal Title="Disconnect Google Calendar?" OnClose="() => _confirmDisconnect = false">
        <ChildContent>
            <p>
                Syncing stops and the saved Google sign-in is removed. Your appointments stay here,
                and the events already on the Google calendar stay there — they simply stop tracking
                each other.
            </p>
            <p class="muted small">
                Reconnecting later starts fresh: every appointment is pushed again, which can create
                duplicates of events that are already on that calendar.
            </p>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _confirmDisconnect = false">Keep it connected</button>
            <button class="btn btn-danger" @onclick="DisconnectGoogle">Disconnect</button>
        </Footer>
    </Modal>
}

@code {
    /// <summary>Sentinel in the drive dropdowns for "let me type a path instead".</summary>
    private const string CustomPathOption = "__custom__";

    private const string DefaultFolderName = "WrenchDesk Backups";

    private Dictionary<string, string> _values = new();
    private string _laborRate = "";
    private string _taxRate = "";
    private string? _flash;
    private long _dbSize;

    private List<DriveOption> _drives = new();
    private List<FileInfo> _backups = new();
    private string _listedFolder = "";
    private bool _busy;

    // Automatic schedule
    private bool _autoEnabled;
    private string _frequency = BackupFrequency.Daily;
    private TimeOnly _scheduleTime = new(18, 0);
    private DayOfWeek _scheduleDay = DayOfWeek.Friday;
    private int _keepCount = 30;
    private string _scheduleRoot = "";
    private string _scheduleFolder = DefaultFolderName;
    private DateTime? _lastRun;
    private string _lastError = "";

    // On-demand backup
    private string _manualRoot = "";
    private string _manualFolder = DefaultFolderName;
    private BackupResult? _manualResult;

    protected override void OnParametersSet() => ReadGoogleOutcome();

    protected override void OnInitialized()
    {
        _drives = BackupService.ListDrives();
        Load();

        // Default the on-demand picker to a removable drive if one is plugged in — that is
        // almost always what someone pressing this button is reaching for.
        var preferred = _drives.FirstOrDefault(d => d.IsRemovable) ?? _drives.FirstOrDefault();
        if (preferred is not null) _manualRoot = preferred.Root;
    }

    private void Load()
    {
        _values = Settings.GetAll();
        _laborRate = (Settings.GetInt(SettingsStore.LaborRateCents) / 100m).ToString("0.00");
        _taxRate = (Settings.GetInt(SettingsStore.TaxRateBp) / 100m).ToString("0.####");

        _autoEnabled = Settings.GetBool(SettingsStore.BackupAutoEnabled);
        _frequency = Settings.Get(SettingsStore.BackupFrequency);
        if (!BackupFrequency.All.Contains(_frequency)) _frequency = BackupFrequency.Daily;

        _scheduleTime = Settings.GetTime(SettingsStore.BackupTimeOfDay, new TimeOnly(18, 0));
        _scheduleDay = Settings.GetDay(SettingsStore.BackupDayOfWeek, DayOfWeek.Friday);
        _keepCount = Math.Max(1, Settings.GetInt(SettingsStore.BackupKeepCount));
        _lastRun = Settings.GetTimestamp(SettingsStore.BackupLastRun);
        _lastError = Settings.Get(SettingsStore.BackupLastError);

        SplitStoredDestination(Settings.Get(SettingsStore.BackupDestination));

        _dbSize = File.Exists(Database.DatabasePath) ? new FileInfo(Database.DatabasePath).Length : 0;

        _listedFolder = Backups.ScheduledDestination;
        _backups = Backups.ListBackups(_listedFolder);

        LoadGoogle();
    }

    /// <summary>Turns a stored absolute path back into the drive + folder the dropdowns work in.</summary>
    private void SplitStoredDestination(string stored)
    {
        if (string.IsNullOrWhiteSpace(stored))
        {
            _scheduleRoot = "";
            _scheduleFolder = DefaultFolderName;
            return;
        }

        var match = _drives.FirstOrDefault(d =>
            stored.StartsWith(d.Root, StringComparison.OrdinalIgnoreCase));

        if (match is not null)
        {
            _scheduleRoot = match.Root;
            _scheduleFolder = stored[match.Root.Length..].Trim('\\', '/');
            if (string.IsNullOrWhiteSpace(_scheduleFolder)) _scheduleFolder = DefaultFolderName;
        }
        else
        {
            // The drive is unplugged, or it is a UNC path — keep it as typed so it is not lost.
            _scheduleRoot = CustomPathOption;
            _scheduleFolder = stored;
        }
    }

    private static string Combine(string root, string folder)
    {
        if (root == CustomPathOption) return folder.Trim();
        if (string.IsNullOrWhiteSpace(root)) return "";

        var clean = folder.Trim().Trim('\\', '/');
        return string.IsNullOrWhiteSpace(clean) ? root : Path.Combine(root, clean);
    }

    private string ScheduleDestination()
    {
        var combined = Combine(_scheduleRoot, _scheduleFolder);
        return string.IsNullOrWhiteSpace(combined) ? Database.BackupDirectory : combined;
    }

    private string ManualDestination()
    {
        var combined = Combine(_manualRoot, _manualFolder);
        return string.IsNullOrWhiteSpace(combined) ? Database.BackupDirectory : combined;
    }

    private void RefreshDrives()
    {
        _drives = BackupService.ListDrives();
        _flash = $"Found {_drives.Count} drive{(_drives.Count == 1 ? "" : "s")}.";
    }

    private void OnManualRootChange(ChangeEventArgs e)
    {
        _manualRoot = e.Value?.ToString() ?? "";
        _manualResult = null;
    }

    private void OnScheduleRootChange(ChangeEventArgs e)
    {
        _scheduleRoot = e.Value?.ToString() ?? "";
        if (_scheduleRoot != CustomPathOption && string.IsNullOrWhiteSpace(_scheduleFolder))
            _scheduleFolder = DefaultFolderName;
        Save();
    }

    private void OnAutoToggle(ChangeEventArgs e)
    {
        _autoEnabled = e.Value is bool b && b;
        Save();
    }

    private void Save()
    {
        if (Money.TryParse(_laborRate, out var laborCents))
            _values[SettingsStore.LaborRateCents] = laborCents.ToString();

        var taxText = _taxRate.Replace("%", "").Trim();
        if (decimal.TryParse(taxText, NumberStyles.Any, CultureInfo.InvariantCulture, out var pct))
            _values[SettingsStore.TaxRateBp] = ((int)Math.Round(pct * 100m, MidpointRounding.AwayFromZero)).ToString();

        _values[SettingsStore.BackupAutoEnabled] = _autoEnabled ? "true" : "false";
        _values[SettingsStore.BackupFrequency] = _frequency;
        _values[SettingsStore.BackupTimeOfDay] = _scheduleTime.ToString("HH:mm");
        _values[SettingsStore.BackupDayOfWeek] = _scheduleDay.ToString();
        _values[SettingsStore.BackupKeepCount] = Math.Clamp(_keepCount, 1, 500).ToString();
        _values[SettingsStore.BackupDestination] = Combine(_scheduleRoot, _scheduleFolder);

        Settings.SetAll(_values);
        _flash = "Settings saved.";
        Load();
    }

    private async Task BackUpToChosen()
    {
        var destination = ManualDestination();
        await RunBackup(destination);
    }

    private async Task BackUpToDataFolder() => await RunBackup(Database.BackupDirectory);

    private async Task RunBackup(string destination)
    {
        _busy = true;
        _manualResult = null;
        StateHasChanged();

        // Writing to a USB stick can take a moment; keep the UI responsive while it happens.
        _manualResult = await Task.Run(() => Backups.CreateBackup(destination, label: "manual"));

        _busy = false;
        Load();
    }

    private static string FormatSize(long bytes) => DriveOption.FormatSize(bytes);

    // ---- Google Calendar ----

    [Parameter, SupplyParameterFromQuery(Name = "google")]
    public string? GoogleOutcome { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "detail")]
    public string? GoogleOutcomeDetail { get; set; }

    private bool _googleConfigured;
    private bool _googleConnected;
    private bool _needsReconnect;
    private bool _syncEnabled;
    private bool _googleBusy;
    private bool _confirmDisconnect;

    private string _googleClientId = "";
    private string _googleClientSecret = "";
    private string _calendarId = "";
    private int _syncIntervalMin = 5;
    private DateTime? _lastSync;
    private string _lastSyncResult = "";
    private string _googleLastError = "";
    private string _redirectUri = "";
    private string _shopNameForCalendar = "WrenchDesk";

    private List<CalendarSummary> _calendars = new();
    private string? _googleFlash;
    private string _googleFlashClass = "alert-ok";

    private void LoadGoogle()
    {
        _googleConfigured = Auth.IsConfigured;
        _googleConnected = Auth.IsConnected;
        _needsReconnect = Settings.GetBool(SettingsStore.GoogleNeedsReconnect);
        _syncEnabled = Settings.GetBool(SettingsStore.GoogleSyncEnabled);

        _googleClientId = Settings.Get(SettingsStore.GoogleClientId);
        _googleClientSecret = Settings.Get(SettingsStore.GoogleClientSecret);
        _calendarId = Settings.Get(SettingsStore.GoogleCalendarId);

        var interval = Settings.GetInt(SettingsStore.GoogleSyncIntervalMin);
        _syncIntervalMin = interval <= 0 ? 5 : interval;

        _lastSync = Settings.GetTimestamp(SettingsStore.GoogleLastSync);
        _lastSyncResult = Settings.Get(SettingsStore.GoogleLastResult);
        _googleLastError = Settings.Get(SettingsStore.GoogleLastError);

        var shopName = Settings.Get(SettingsStore.ShopName);
        _shopNameForCalendar = string.IsNullOrWhiteSpace(shopName) ? "WrenchDesk" : $"{shopName} — Schedule";

        // Google only accepts a loopback redirect for a desktop-style app, and it must match exactly.
        var uri = new Uri(Nav.BaseUri);
        _redirectUri = $"http://localhost:{uri.Port}/google/callback";
    }

    /// <summary>Turns the ?google= marker the OAuth callback redirects back with into a message.</summary>
    private void ReadGoogleOutcome()
    {
        if (string.IsNullOrWhiteSpace(GoogleOutcome)) return;

        (_googleFlash, _googleFlashClass) = GoogleOutcome switch
        {
            "connected" => ("Connected to Google. Now pick which calendar to sync with.", "alert-ok"),
            "denied" => ("Google sign-in was cancelled, so nothing changed.", "alert-warn"),
            "notconfigured" => ("Save your client ID and secret first.", "alert-warn"),
            "nocode" => ("Google did not send an authorisation code back. Try connecting again.", "alert-danger"),
            "failed" => ($"Could not finish connecting: {GoogleOutcomeDetail}", "alert-danger"),
            _ => (null, "alert-ok")
        };
    }

    private void SaveGoogleCredentials()
    {
        Settings.SetAll(new Dictionary<string, string>
        {
            [SettingsStore.GoogleClientId] = _googleClientId.Trim(),
            [SettingsStore.GoogleClientSecret] = _googleClientSecret.Trim()
        });

        _googleFlash = "Credentials saved. Now press Connect Google account.";
        _googleFlashClass = "alert-ok";
        LoadGoogle();
    }

    private void SaveGoogleSettings()
    {
        Settings.SetAll(new Dictionary<string, string>
        {
            [SettingsStore.GoogleCalendarId] = _calendarId,
            [SettingsStore.GoogleCalendarName] = _calendars.FirstOrDefault(c => c.Id == _calendarId)?.Name ?? "",
            [SettingsStore.GoogleSyncEnabled] = _syncEnabled ? "true" : "false",
            [SettingsStore.GoogleSyncIntervalMin] = _syncIntervalMin.ToString()
        });

        LoadGoogle();
    }

    private async Task LoadCalendars()
    {
        _googleBusy = true;
        _googleFlash = null;
        StateHasChanged();

        try
        {
            var api = await Auth.CreateApiAsync();
            _calendars = (await api.ListCalendarsAsync(CancellationToken.None)).ToList();

            if (_calendars.Count == 0)
            {
                _googleFlash = "That account has no calendars you can write to.";
                _googleFlashClass = "alert-warn";
            }
        }
        catch (Exception ex)
        {
            _googleFlash = ex.Message;
            _googleFlashClass = "alert-danger";
        }

        _googleBusy = false;
        LoadGoogle();
    }

    private async Task CreateShopCalendar()
    {
        _googleBusy = true;
        _googleFlash = null;
        StateHasChanged();

        try
        {
            var api = await Auth.CreateApiAsync();
            var created = await api.CreateCalendarAsync(_shopNameForCalendar, CancellationToken.None);

            _calendars = (await api.ListCalendarsAsync(CancellationToken.None)).ToList();
            _calendarId = created.Id;
            SaveGoogleSettings();

            _googleFlash = $"Created “{created.Name}” and selected it. Turn syncing on below.";
            _googleFlashClass = "alert-ok";
        }
        catch (Exception ex)
        {
            _googleFlash = ex.Message;
            _googleFlashClass = "alert-danger";
        }

        _googleBusy = false;
        LoadGoogle();
    }

    private void OnCalendarChange(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString() ?? "";

        // Switching calendars would otherwise leave every appointment pointing at an event on the
        // old one, so start the links and the incremental token clean.
        if (!string.IsNullOrWhiteSpace(_calendarId) && picked != _calendarId)
        {
            Schedule.ClearAllGoogleLinks();
            Settings.Set(SettingsStore.GoogleSyncToken, "");
        }

        _calendarId = picked;
        SaveGoogleSettings();
    }

    private void OnSyncToggle(ChangeEventArgs e)
    {
        _syncEnabled = e.Value is bool b && b;
        SaveGoogleSettings();
    }

    private async Task SyncNow()
    {
        _googleBusy = true;
        _googleFlash = null;
        StateHasChanged();

        try
        {
            var api = await Auth.CreateApiAsync();
            var report = await Sync.SyncAsync(api, _calendarId, CancellationToken.None);

            _googleFlash = report.Describe();
            _googleFlashClass = report.Success ? "alert-ok" : "alert-danger";
        }
        catch (Exception ex)
        {
            _googleFlash = ex.Message;
            _googleFlashClass = "alert-danger";
        }

        _googleBusy = false;
        LoadGoogle();
    }

    private void DisconnectGoogle()
    {
        Auth.Disconnect();
        Schedule.ClearAllGoogleLinks();

        _confirmDisconnect = false;
        _calendars = new();
        _googleFlash = "Disconnected from Google Calendar.";
        _googleFlashClass = "alert-ok";
        LoadGoogle();
    }
}

@inject SettingsStore Settings

<a class="brand" href="/">
    <span class="mark"><ShopLogo Variant="ShopLogo.LogoVariant.Mark" Alt="@_shopName" /></span>
    <span>@_shopName</span>
</a>

<nav class="nav-list">
    <NavLink href="/" Match="NavLinkMatch.All"><span class="ico">▦</span> Dashboard</NavLink>
    <NavLink href="/customers"><span class="ico">👤</span> Customers</NavLink>
    <NavLink href="/tickets"><span class="ico">🎫</span> Tickets</NavLink>
    <NavLink href="/schedule"><span class="ico">📅</span> Schedule</NavLink>
    <NavLink href="/money"><span class="ico">💵</span> Money</NavLink>
    <NavLink href="/settings"><span class="ico">⚙</span> Settings</NavLink>
</nav>

<div class="sidebar-foot">
    Everything is stored on this PC.<br />
    Set up backups in <a href="/settings" style="color:inherit;text-decoration:underline">Settings</a>.
</div>

@code {
    private string _shopName = "WrenchDesk";

    protected override void OnInitialized()
    {
        var name = Settings.Get(SettingsStore.ShopName);
        if (!string.IsNullOrWhiteSpace(name)) _shopName = name;
    }
}

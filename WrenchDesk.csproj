<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-only already, and the tray icon needs the desktop framework. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- WinExe means no console window. The shop sees a tray icon instead of a black box they
         are told not to close. -->
    <OutputType>WinExe</OutputType>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Gives the .exe itself the shop badge, which is what desktop and taskbar shortcuts show. -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>

    <AssemblyTitle>WrenchDesk</AssemblyTitle>
    <Product>WrenchDesk</Product>
    <Company>Walt's Small Engines</Company>
    <Description>Shop management for Walt's Small Engines</Description>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!--
    Baked into the assembly so the published program is genuinely one file. Without this the
    stylesheet and icon sit in a wwwroot folder beside the .exe, and "download one file and
    double-click it" stops being true the moment someone moves the .exe on its own.
  -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\app.css" />
    <EmbeddedResource Include="wwwroot\favicon.ico" />
  </ItemGroup>

  <!-- The Web SDK globs **/*.cs, which would otherwise pull the test project into the app. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

</Project>
